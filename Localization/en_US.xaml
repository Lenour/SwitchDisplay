<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Display -->
    <sys:String x:Key="LOCSwitchDisplaySwitchDisplays">Switch Displays:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayFullscreenDisplay">Fullscreen (TV) Primary Display:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayDefaultDisplay">Desktop Primary Display:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayDisplayString">{0} — {1}</sys:String>
    <sys:String x:Key="LOCSwitchDisplayDisableInFullscreen">Monitors to disable in TV mode (always off):</sys:String>
    <sys:String x:Key="LOCSwitchDisplayPreserveState">Monitors with preserved state:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayPreserveStateHint">These monitors are always disabled in TV mode. On returning to desktop, they are only re-enabled if they were active before.</sys:String>
    <sys:String x:Key="LOCSwitchDisplayActivationDelay">TV activation delay:</sys:String>

    <!-- Audio -->
    <sys:String x:Key="LOCSwitchDisplaySwitchAudio">Switch Audio:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayFullscreenAudioOutput">Fullscreen Audio Output (priority order):</sys:String>
    <sys:String x:Key="LOCSwitchDisplayDefaultAudioOutput">Desktop Audio Output:</sys:String>
    <sys:String x:Key="LOCSwitchDisplayAutoDetectAudioOutput">Auto-detect desktop audio (save current on enter, restore on exit)</sys:String>
    <sys:String x:Key="LOCSwitchDisplayAudioRetryTimeout">Audio switch retry timeout:</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="LOCSwitchDisplayUp">Up</sys:String>
    <sys:String x:Key="LOCSwitchDisplayDown">Down</sys:String>
    <sys:String x:Key="LOCSwitchDisplayRemove">Remove</sys:String>
    <sys:String x:Key="LOCSwitchDisplayAdd">Add</sys:String>

</ResourceDictionary>
